Method:     native
Game:       @ROOT@/game.sh
Command:    @ROOT@/game.sh
Environment:
  HOME=@ROOT@/home
  USER=tester
  LOGNAME=tester
  SHELL=/bin/bash
  PATH=@ROOT@/bin:/usr/bin:/bin
  DISPLAY=:99
  WAYLAND_DISPLAY=wayland-test
  XDG_RUNTIME_DIR=@ROOT@/run
  DBUS_SESSION_BUS_ADDRESS=unix:path=@ROOT@/bus
