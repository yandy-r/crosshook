{
  "game": {
    "name": "Synthetic Quest",
    "executable_path": "/games/synthetic-quest/game.exe",
    "custom_cover_art_path": "/art/cover.png",
    "custom_portrait_art_path": "/art/portrait.png",
    "custom_background_art_path": "/art/bg.png"
  },
  "trainer": {
    "path": "/trainers/synthetic-trainer.exe",
    "type": "FLiNG",
    "trainer_type": "standalone",
    "loading_mode": "copy_to_prefix",
    "required_protontricks": [
      "vcrun2022",
      "dotnet48"
    ],
    "community_trainer_sha256": ""
  },
  "injection": {
    "dll_paths": [
      "/hooks/overlay.dll",
      "C:\\Hooks\\helper.dll"
    ],
    "inject_on_launch": [
      true,
      false
    ],
    "loaded_hooks": [
      {
        "id": "hook-1",
        "name": "Overlay",
        "path": "/hooks/overlay.dll",
        "enabled": true
      },
      {
        "id": "loaded-dll-hook-2",
        "name": "helper.dll",
        "path": "C:\\Hooks\\helper.dll",
        "enabled": false
      }
    ],
    "method": "load_library",
    "stage": "game_process_ready",
    "timeout_ms": 5000,
    "fallback": "disable_hook"
  },
  "steam": {
    "enabled": false,
    "app_id": "",
    "compatdata_path": "",
    "proton_path": "",
    "launcher": {
      "icon_path": "/icons/synthetic.png",
      "display_name": "Synthetic Quest"
    }
  },
  "runtime": {
    "prefix_path": "/prefixes/synthetic-quest",
    "proton_path": "/compat/GE-Proton9-20",
    "working_directory": "/games/synthetic-quest",
    "steam_app_id": "9999001",
    "umu_game_id": "umu-9999001",
    "umu_store": "gog",
    "umu_codename": "Synthetic_Quest",
    "umu_preference": "umu"
  },
  "launch": {
    "method": "proton_run",
    "optimizations": {
      "enabled_option_ids": [
        "use_gamemode",
        "show_mangohud_overlay"
      ]
    },
    "command_arguments": {
      "enabled_argument_ids": [
        "force_vulkan",
        "skip_launcher"
      ],
      "custom_args": [
        "-windowed",
        "+set sv_cheats 1"
      ]
    },
    "presets": {
      "Balanced": {
        "enabled_option_ids": [
          "use_gamemode"
        ]
      }
    },
    "active_preset": "",
    "custom_env_vars": {
      "DXVK_HUD": "fps,devinfo",
      "PROTON_LOG": "1"
    },
    "network_isolation": false,
    "gamescope": {
      "enabled": true,
      "internal_width": 1920,
      "internal_height": 1080,
      "output_width": 2560,
      "output_height": 1440,
      "frame_rate_limit": 60,
      "fsr_sharpness": 5,
      "upscale_filter": "fsr",
      "fullscreen": true,
      "borderless": false,
      "grab_cursor": true,
      "force_grab_cursor": false,
      "hdr_enabled": false,
      "allow_nested": false,
      "extra_args": [
        "--mangoapp"
      ]
    },
    "trainer_gamescope": {
      "enabled": true,
      "internal_width": 800,
      "internal_height": 600,
      "fullscreen": false,
      "borderless": false,
      "grab_cursor": false,
      "force_grab_cursor": false,
      "hdr_enabled": false,
      "allow_nested": true,
      "extra_args": []
    },
    "mangohud": {
      "enabled": true,
      "fps_limit": 120,
      "gpu_stats": true,
      "cpu_stats": true,
      "ram": false,
      "frametime": true,
      "battery": false,
      "watt": false,
      "position": "top-left"
    }
  },
  "pre_launch_hooks": [
    {
      "id": "pre-1",
      "name": "Prepare saves",
      "path": "/scripts/pre.sh",
      "stage": "pre-launch",
      "enabled": true
    }
  ],
  "post_exit_hooks": [
    {
      "id": "post-1",
      "name": "Backup saves",
      "path": "/scripts/post.sh",
      "stage": "post-exit",
      "enabled": false
    }
  ],
  "local_override": {
    "game": {
      "executable_path": "",
      "custom_cover_art_path": "",
      "custom_portrait_art_path": "",
      "custom_background_art_path": ""
    },
    "trainer": {
      "path": "",
      "extra_protontricks": []
    },
    "steam": {
      "compatdata_path": "",
      "proton_path": ""
    },
    "runtime": {
      "prefix_path": "",
      "proton_path": ""
    }
  }
}
