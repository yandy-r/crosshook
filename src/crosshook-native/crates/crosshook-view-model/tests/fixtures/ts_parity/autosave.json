  "chip_cases": [
    {
      "name": "error_beats_all_other_tones",
      "statuses": [
        {
          "tone": "idle",
          "label": "Ready"
        },
        {
          "tone": "success",
          "label": "Saved automatically"
        },
        {
          "tone": "warning",
          "label": "Save profile first"
        },
        {
          "tone": "saving",
          "label": "Saving..."
        },
        {
          "tone": "error",
          "label": "Failed to save"
        }
      ],
      "expected_tone": "error",
      "expected_label": "Failed to save",
      "visible_at_2999ms": true,
      "visible_at_3000ms": true
    },
