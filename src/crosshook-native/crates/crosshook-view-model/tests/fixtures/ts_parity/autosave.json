      "name": "rapid_profile_draft_edits_coalesce",
      "scope": {
        "selected_profile": "Test Game",
        "draft_name": "Test Game",
        "profile_exists": true,
        "launch_method": "proton_run"
      },
      "steps": [
        {
          "at_ms": 0,
          "kind": "edit",
          "section": "profile_draft",
          "revision": "111"
        },
        {
          "at_ms": 150,
          "kind": "edit",
          "section": "profile_draft",
          "revision": "222"
        },
        {
          "at_ms": 300,
          "kind": "edit",
          "section": "profile_draft",
          "revision": "333"
        },
        {
          "at_ms": 650,
          "kind": "advance_to"
        }
      ],
      "expected_saves": [
        {
          "at_ms": 650,
          "target": "full_profile",
          "section_kind": null,
          "profile_name": "Test Game",
          "revision": "333"
        }
      ],
      "final_value": "333"
    },
